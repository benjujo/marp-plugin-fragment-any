{
  "name": "marp-plugin-fragment-any",
  "version": "1.0.0",
  "description": "Marpit plugin to fragment any block element via <!-- fragment --> HTML comments",
  "keywords": ["marp", "marpit", "plugin", "fragment", "presentation", "slides"],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check:ts": "tsc --noEmit"
  },
  "peerDependencies": {
    "@marp-team/marpit": ">=2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
